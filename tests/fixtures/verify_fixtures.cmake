# usage: cmake -DROOT=<repo root> -P verify_fixtures.cmake
# Checks (1) every fixture listed in tests/data/MANIFEST.sha256 and (2) the ORIGINAL data/sample.pcap against the root MANIFEST.sha256.
# Reports whether original and regenerated sample are identical; does not require it. Never writes anything.
cmake_minimum_required(VERSION 3.14)
if(NOT ROOT)
  message(FATAL_ERROR "pass -DROOT=<repo root>")
endif()
set(fails 0)

function(check_manifest manifest only_path)
  file(STRINGS "${ROOT}/${manifest}" lines)
  set(local_fails 0)
  foreach(l IN LISTS lines)
    if(l MATCHES "^([0-9a-f]+)  (.+)$")
      set(h "${CMAKE_MATCH_1}")
      set(p "${CMAKE_MATCH_2}")
      if(only_path AND NOT p STREQUAL only_path)
        continue()
      endif()
      if(NOT EXISTS "${ROOT}/${p}")
        message(STATUS "MISSING  ${p}")
        math(EXPR local_fails "${local_fails}+1")
      else()
        file(SHA256 "${ROOT}/${p}" actual)
        if(actual STREQUAL h)
          message(STATUS "ok       ${p}")
        else()
          message(STATUS "MISMATCH ${p}")
          message(STATUS "         expected ${h}")
          message(STATUS "         actual   ${actual}")
          math(EXPR local_fails "${local_fails}+1")
        endif()
      endif()
    endif()
  endforeach()
  set(fails "${local_fails}" PARENT_SCOPE)
endfunction()

check_manifest("tests/data/MANIFEST.sha256" "")
set(total "${fails}")
check_manifest("MANIFEST.sha256" "data/sample.pcap")
math(EXPR total "${total}+${fails}")

if(EXISTS "${ROOT}/data/sample.pcap" AND EXISTS "${ROOT}/tests/data/regenerated/sample_regenerated.pcap")
  file(SHA256 "${ROOT}/data/sample.pcap" a)
  file(SHA256 "${ROOT}/tests/data/regenerated/sample_regenerated.pcap" b)
  if(a STREQUAL b)
    message(STATUS "info: original and regenerated sample are byte-identical (sha256 ${a})")
  else()
    message(STATUS "info: original and regenerated sample DIFFER (original ${a} / regenerated ${b})")
  endif()
endif()
if(total GREATER 0)
  message(FATAL_ERROR "${total} fixture check(s) failed")
endif()
